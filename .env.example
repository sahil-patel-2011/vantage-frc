# --- Neon / Vercel database URLs (production) ---
# Neon Integration often provides DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED.
# Map those into Vantage role aliases with: node scripts/map-neon-env.mjs
# Required on Vercel Production (and Preview if product routes run there):
#   DATABASE_URL                 pooled product request role (RLS / vantage_app)
#   DATABASE_ADMIN_URL           UNPOOLED — migrations + workers only (vantage_worker)
#   DATABASE_AUTH_URL            Better Auth session DB (usually same as pooled)
#   MARKETING_DATABASE_URL       marketing Neon role (or pooled until split)
#   DATABASE_BILLING_URL         Stripe webhook role (or pooled until split)
#   DATABASE_DISPLAY_URL         pit-TV snapshot execute-only (or pooled)
#   DATABASE_ALLIANCE_BOARD_URL  alliance-board share execute-only (or pooled)
#   DATABASE_CAD_RELAY_URL       CAD Fusion relay pairing (or pooled)
# Prefer dedicated least-privilege Neon roles when provisioned; until then aliases
# may share the pooled/unpooled strings. Never commit real connection strings.
#
# Marketing-only Neon role. Do not use a product or service-role URL here.
MARKETING_DATABASE_URL=
# Product request role (RLS enforced) and worker-only service role.
DATABASE_URL=
DATABASE_ADMIN_URL=
DATABASE_AUTH_URL=
# Least-privilege Stripe webhook role (vantage_billing).
DATABASE_BILLING_URL=
# Execute-only role for revocable pit-TV snapshots.
DATABASE_DISPLAY_URL=
# Execute-only role for mentor alliance-board share links.
DATABASE_ALLIANCE_BOARD_URL=
MFA_ENCRYPTION_KEY=
MFA_RECOVERY_PEPPER=
EXPORT_ENCRYPTION_KEY=
TBA_AUTH_KEY=
FIRST_EVENTS_USERNAME=
FIRST_EVENTS_AUTHORIZATION_TOKEN=
BETTER_AUTH_SECRET=
# Use https://vantage-frc-web.vercel.app in production (or your custom domain once attached).
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Canonical public origin for SEO (metadataBase, OG, sitemap, robots, llms.txt).
# When you buy a domain: set this to https://your-domain.com and redeploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional comma-separated extra Better Auth trusted origins (custom domains, previews).
AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production email OTP / default email 2FA / forgot-password (not Google OAuth). Neon stays the auth database.
# Set both on Vercel Production and redeploy; until then email 2FA stays not enforced.
# Shared Resend credentials for auth OTP/2FA and opt-in product/coach emails.
# Without both, production email delivery returns setup_required (auth 2FA stays off).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Vantage <access@example.com>
# Emergency only — leaves email 2FA off even when Resend is configured. Default: unset/false.
ENABLE_EMAIL_2FA_BYPASS=
# Local-only placeholder — replace in .env.local; never use a production value here.
DEV_OTP_SECRET=

# Web Push (match alerts / reminders to a device even when the app is closed).
# Without both keys, push degrades to "server setup" and in-app notifications still work.
# Generate a keypair once with: npx tsx scripts/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vantagefrc.com

# Platform owner bootstrap (never commit real passwords).
# Seed with: npx tsx scripts/bootstrap-platform-owner.ts
# Or POST /api/admin/bootstrap-owner with header x-bootstrap-token: $BOOTSTRAP_TOKEN
PLATFORM_OWNER_EMAIL=sahiljpatel2011@gmail.com
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=Sahil Patel
BOOTSTRAP_TOKEN=

# Global reference ingest. Only TBA requires a credential; Statbotics is keyless.
# Canonical env name is TBA_AUTH_KEY; TBA_API_KEY is accepted as an alias.
TBA_AUTH_KEY=
TBA_API_KEY=
TBA_API_BASE_URL=https://www.thebluealliance.com/api/v3
STATBOTICS_API_BASE_URL=https://api.statbotics.io/v3
STATBOTICS_MIN_INTERVAL_MS=350
STATBOTICS_MAX_ATTEMPTS=4
REFERENCE_INGEST_USER_AGENT=Vantage-Reference-Ingest/1.0
# Authorizes /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# Used by TBA sync and sponsor thank-you / renewal / overdue reminder jobs.
CRON_SECRET=

# Optional pluggable research search provider. With these blank, local fixtures are used.
RESEARCH_SEARCH_ENDPOINT=
RESEARCH_SEARCH_API_KEY=
RESEARCH_MAX_TEAMS=60
RESEARCH_MAX_QUERIES_PER_TEAM=2
RESEARCH_MAX_RESULTS_PER_QUERY=5

# Soft-UI Autonomous Agent web tools (/ai?tab=agent). Prefer Brave; else RESEARCH_SEARCH_*.
# Leave blank → web.search returns setup_required (honest). Never invent search hits.
BRAVE_SEARCH_API_KEY=
# Allowlisted HTTPS fetch (FIRST/TBA/Statbotics/WPILib docs). false → web.fetch setup_required.
AGENT_WEB_BROWSE_ENABLED=true

# Optional production integrations. Local development uses safe substitutes.
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local-only placeholder — replace in .env.local; never commit a real key.
DEV_KMS_MASTER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Browser tests only. Playwright supplies this to the local dev server.
# Never configure it in Vercel; production code ignores it regardless.
E2E_AUTH_FIXTURE=

# CAD — Fusion local relay signing (must match Fusion add-in env when using live Autodesk).
FUSION_RELAY_SIGNING_SECRET=
DATABASE_CAD_RELAY_URL=

# CAD — Onshape hosted OAuth (leave blank → Setup-required UI).
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
# Optional; defaults to $BETTER_AUTH_URL/api/cad/onshape/oauth/callback
ONSHAPE_OAUTH_REDIRECT_URI=
ONSHAPE_OAUTH_SCOPES=OAuth2Read OAuth2Write

# Discord — team guild/channel + announcements / optional chat bridge.
# Leave blank → Setup-required UI for bot posting. Teams can still paste a
# channel webhook in /team/discord for announcements without the bot.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# GitHub — org robot-code context (Team → #github-connection). Leave blank → OAuth button
# disabled only; feature is NOT setup_required — encrypted PAT path still works in production.
# Vercel checklist: docs/GITHUB_CONNECTION.md
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional; defaults to $BETTER_AUTH_URL/api/github/oauth/callback
GITHUB_OAUTH_REDIRECT_URI=
# Classic scopes; never include workflow. App only calls read APIs.
GITHUB_OAUTH_SCOPES=read:user repo
# Optional HMAC override for OAuth state (defaults to BETTER_AUTH_SECRET)
# GITHUB_OAUTH_STATE_SECRET=

# Platform-sponsored free/promo AI pool (team 1111 promotional window).
# Values must only live in Vercel project env or gitignored .env.local � never commit secrets.
# Failover order: Mistral ? Cerebras ? Groq ? Cohere (rate-limit / quota).
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
