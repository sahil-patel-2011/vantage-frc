# Normalize line endings in the repository. Without this, a Windows checkout writes
# CRLF into files that must not have it.
* text=auto

# Executable scripts MUST be LF. A shebang followed by CRLF makes the kernel look for
# an interpreter literally named "node\r", so `./server.mjs` dies with "no such file or
# directory" on Linux/macOS — including the Raspberry Pi the storage node is built for.
# It also breaks Vitest, whose shebang stripping leaves the stray \r and then reports
# "SyntaxError: Invalid or unexpected token" with no file or line to go on.
*.mjs text eol=lf
*.sh  text eol=lf

# Shell-adjacent and container files that are read by Linux tooling.
Dockerfile      text eol=lf
*.service       text eol=lf
docker-compose.yml text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff  binary
*.woff2 binary
*.pdf binary
*.exe binary
