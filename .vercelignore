# What NOT to upload to Vercel.
#
# Vercel installs dependencies and runs the build itself, so shipping local
# build output and node_modules is pure waste — a CLI deploy from this repo
# uploaded 354 MB before this file existed, almost all of it apps/web/.next
# (3.5 GB on disk) and node_modules (656 MB). The CLI does not reliably fall
# back to .gitignore for uploads, so these have to be listed here even though
# git already ignores them.
#
# Git-triggered deploys are unaffected (they never upload local files); this
# only governs `vercel deploy` from a workstation.
#
# ANCHOR ANYTHING THAT EXISTS ONLY AT THE ROOT. These are .gitignore patterns:
# a bare name with no slash matches a path *segment at any depth*, so `coverage`
# silently dropped apps/web/app/api/scouting/coverage/route.ts out of every CLI
# deploy — a route that exists precisely because /scouting/lineup used to 404
# without it (see apps/web/lib/scouting/coverage.ts). A leading `/` scopes the
# pattern to this directory. Only patterns that genuinely recur per workspace
# (node_modules, .next, dist, …) may stay unanchored; before adding an
# unanchored one, check `git ls-files | grep -E "(^|/)<name>/"` is empty.

# Installed and built on Vercel, never uploaded. Unanchored on purpose: these
# appear under every workspace (apps/*/.next, packages/*/dist).
node_modules
.next
dist
*.tsbuildinfo

# Build output that only ever exists where it is written
/out
/apps/desktop/release
/apps/*/out

# Version control and local tooling
/.git
/.github
/.vercel

# Agent worktrees — each is a full duplicate checkout. Ten of these once put
# 452,390 files in this directory and broke `vercel deploy` outright with
# "files should NOT have more than 15000 items, received 50400".
/.claude/worktrees
/.freebuff

# Test and coverage artifacts
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# Local environment and scratch files
.env
.env.*
!.env.example
*.log
/scratchpad
/pgdata
