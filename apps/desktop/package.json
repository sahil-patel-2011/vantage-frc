{
  "name": "@vantage/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Vantage desktop shell for FRC teams \u2014 signed-in product in a native window.",
  "author": "Vantage",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahil-patel-2011/vantage-frc.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "tsc && electron-builder --win nsis msi portable",
    "dist:win:cross": "tsc && electron-builder --win nsis portable --x64",
    "dist:mac": "tsc && electron-builder --mac dmg zip",
    "dist:all": "tsc && electron-builder --win nsis msi portable --mac dmg zip"
  },
  "devDependencies": {
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "app.vantage.frc",
    "productName": "Vantage",
    "copyright": "Copyright \u00a9 Vantage",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sahil-patel-2011",
        "repo": "vantage-frc",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "offline.html",
      "gate.html",
      "update.html",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Vantage",
        "schemes": [
          "vantage-frc"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Vantage-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "msi": {
      "artifactName": "Vantage-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vantage",
      "artifactName": "Vantage-${version}-win-${arch}-setup.${ext}",
      "license": "build/UNSIGNED.txt"
    },
    "portable": {
      "artifactName": "Vantage-${version}-win-${arch}-portable.${ext}"
    }
  }
}
