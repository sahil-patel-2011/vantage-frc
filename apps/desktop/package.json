{
  "name": "@vantage/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Vantage desktop shell for FRC teams — signed-in product in a native window.",
  "author": "Vantage",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "tsc && electron-builder --win nsis msi portable",
    "dist:mac": "tsc && electron-builder --mac dmg zip",
    "dist:all": "tsc && electron-builder --win nsis msi portable --mac dmg zip"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "app.vantage.frc",
    "productName": "Vantage",
    "copyright": "Copyright © Vantage",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "offline.html",
      "gate.html",
      "update.html",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Vantage",
        "schemes": ["vantage-frc"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "artifactName": "Vantage-${version}-mac-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "Vantage-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vantage",
      "artifactName": "Vantage-${version}-win-${arch}-setup.${ext}",
      "license": "build/UNSIGNED.txt"
    },
    "portable": {
      "artifactName": "Vantage-${version}-win-${arch}-portable.${ext}"
    }
  }
}
