{
  "name": "vantage",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@vantage/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:browser": "npx tsx tests/browser/playwright-shards.ts",
    "test:browser:attach": "playwright test -c playwright.fixture.config.ts",
    "test:browser:install": "playwright install chromium",
    "test:migrations": "vitest run packages/db/src/migrations-unique.test.ts scripts/deploy-preflight.test.ts",
    "test:db:integration": "vitest run packages/db/src/postgres-integration.test.ts",
    "test:cad": "npm test --workspace=@vantage/cad && npm test --workspace=@vantage/cad-cli",
    "desktop:dev": "npm run dev --workspace=@vantage/desktop",
    "desktop:dist": "npm run dist --workspace=@vantage/desktop",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:map-neon": "node scripts/map-neon-env.mjs",
    "db:neon-preflight": "node scripts/neon-preflight.mjs",
    "cad:package": "node scripts/cad/package-relay.mjs",
    "cad:package:linux": "bash scripts/cad/package-linux.sh",
    "cad:package:macos": "bash scripts/cad/package-macos.sh",
    "cad:bundle": "node scripts/cad/bundle-cli.mjs",
    "cad:ci": "npm run typecheck --workspace=@vantage/cad && npm run typecheck --workspace=@vantage/cad-cli && npm run test:cad && npm run build --workspace=@vantage/cad-cli && npm run cad:package",
    "vscode:package": "npm run package --workspace=vantage-vscode"
  },

  "devDependencies": {
    "@eslint/js": "latest",
    "@next/eslint-plugin-next": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
