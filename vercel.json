{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build --workspace=@vantage/web",
  "outputDirectory": "apps/web/.next",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/tba-sync?mode=event-day",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/tba-sync?mode=season",
      "schedule": "0 6 * * *"
    }
  ]
}
